---
import Base from "../../layouts/Base.astro";
import { getPosts, groupPosts, partTitle, formatDate, isoDate } from "../../lib/posts";
import { site } from "../../data/site";

const posts = await getPosts();
const groups = groupPosts(posts);
const count = String(posts.length).padStart(2, "0");
---

<Base title="Blog" description="Written notes by Kokko Ng on data structures, computer architecture, and agentic developer tooling.">
  <div class="stream">
    <p class="label" style="margin-bottom: 14px">Blog &mdash; {count}</p>
    <p class="lede" style="margin: 0 0 26px">{site.intros.blog}</p>

    {
      posts.length === 0 ? (
        <p class="lede" style="margin: 0">No notes have been published yet.</p>
      ) : (
        groups.map((group) => (
          <section class="group">
            <div class="group__head">
              <h2 class="group__name">{group.name}</h2>
              <p class="group__count">
                {group.kind === "series"
                  ? `${group.posts.length} part${group.posts.length === 1 ? "" : "s"}`
                  : `${group.posts.length} note${group.posts.length === 1 ? "" : "s"}`}
              </p>
            </div>

            <div class="posts">
              {group.posts.map((post) => (
                <article class:list={["post-item", group.kind === "series" && "post-item--part"]}>
                  {group.kind === "series" && (
                    <p class="post-item__part">pt. {post.data.series?.part}</p>
                  )}
                  <div class="post-item__body">
                    <div class="post-item__head">
                      <h3 class="post-item__title">
                        <a href={`/blog/${post.id}/`}>{partTitle(post)}</a>
                        {post.data.draft && <span class="draft-flag">Draft</span>}
                      </h3>
                      <time class="label" datetime={isoDate(post.data.pubDate)}>
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>
                    <p class="post-item__blurb">{post.data.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      )
    }
  </div>
</Base>
