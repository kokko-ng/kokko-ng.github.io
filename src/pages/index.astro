---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base>
  <div class="stream">
    <h1 class="statement">{site.positioning}</h1>
    <p class="lede">{site.intro}</p>

    {
      site.now.length > 0 && (
        <dl class="kv">
          {site.now.map((item) => (
            <>
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </>
          ))}
        </dl>
      )
    }
  </div>
</Base>
