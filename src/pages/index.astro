---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { getPosts, formatDate, isoDate } from "../lib/posts";

const recent = (await getPosts()).slice(0, 4);
---

<Base>
  <div class="stream">
    <h1 class="statement">{site.positioning}</h1>
    <p class="lede">{site.intro}</p>

    {
      site.now.length > 0 && (
        <dl class="kv">
          {site.now.map((item) => (
            <>
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </>
          ))}
        </dl>
      )
    }

    {
      recent.length > 0 && (
        <>
          <p class="label" style="margin: 52px 0 16px">Recent writing</p>
          <div class="rows">
            {recent.map((post) => (
              <a class="row" href={`/blog/${post.id}/`}>
                <span class="row__title">{post.data.title}</span>
                <time class="row__date" datetime={isoDate(post.data.pubDate)}>
                  {formatDate(post.data.pubDate)}
                </time>
              </a>
            ))}
          </div>
        </>
      )
    }
  </div>
</Base>
